<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp"
    android:gravity="center" android:background="#0F0F1A">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="📚 QA Bot" android:textSize="32sp" android:textColor="#7C6AFF"
        android:textStyle="bold" android:layout_marginBottom="8dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Savol va javobni kiriting" android:textSize="14sp"
        android:textColor="#888888" android:layout_marginBottom="40dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="1. Savol kiriting" android:textColor="#CCCCCC"
        android:textSize="13sp" android:layout_marginBottom="8dp"/>
    <EditText android:id="@+id/etSavol" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Savolingizni yozing..."
        android:hintTextColor="#555555" android:textColor="#FFFFFF"
        android:background="@drawable/input_bg" android:padding="14dp"
        android:textSize="15sp" android:minLines="2" android:maxLines="5"
        android:inputType="textMultiLine" android:layout_marginBottom="24dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="2. Javob kiriting" android:textColor="#CCCCCC"
        android:textSize="13sp" android:layout_marginBottom="8dp"/>
    <EditText android:id="@+id/etJavob" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Javobni yozing..."
        android:hintTextColor="#555555" android:textColor="#FFFFFF"
        android:background="@drawable/input_bg" android:padding="14dp"
        android:textSize="15sp" android:minLines="2" android:maxLines="5"
        android:inputType="textMultiLine" android:layout_marginBottom="40dp"/>
    <Button android:id="@+id/btnDavom" android:layout_width="match_parent"
        android:layout_height="56dp" android:text="3. Davom etish →"
        android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
        android:background="@drawable/btn_bg" android:stateListAnimator="@null"/>
</LinearLayout>
